# Public site URL — used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://scalewithbikash.com

# Resend (https://resend.com) — powers the /contact form.
# Without this set, submissions are logged to the server console instead of
# emailed, so local development works with zero configuration.
RESEND_API_KEY=

# Where contact form submissions are delivered. Defaults to
# scalewithbikash@gmail.com if unset.
CONTACT_EMAIL=scalewithbikash@gmail.com

# The "from" address Resend sends as. Must be on a domain verified in your
# Resend account. Defaults to Resend's shared onboarding address, which works
# for testing but should be replaced with a verified domain in production.
CONTACT_FROM_EMAIL=onboarding@resend.dev
